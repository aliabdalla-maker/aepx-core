{
  "version": "2026.11.18-1",
  "body": {
    "hash_signatures": [
      {"id": "sig.eicar.sha256", "sha256": "275a021bbfb6489e54d471899f7db9d1663fc695ec2fe2a2c4538aabf651fd0f",
       "name": "EICAR-Test-File (not a virus)", "severity": "high"}
    ],
    "byte_signatures": [
      {"id": "sig.eicar.bytes", "name": "EICAR-Test-File (embedded)", "severity": "high", "max_offset": 4096,
       "pattern_hex": "58354f2150254041505b345c505a58353428505e29374343"}
    ],
    "reputation": {
      "block_sha256": [],
      "trusted_sha256": [],
      "malicious_domains": [],
      "malicious_urls": []
    },
    "behaviour_rules": [
      {"id": "beh.script.encoded_powershell", "version": "1", "title": "Encoded PowerShell command",
       "technique": "T1059.001", "severity": "high", "kind": "process_start",
       "all": [{"field": "process", "regex": "^(powershell|pwsh)(\\.exe)?$"}],
       "any": [{"field": "cmdline", "regex": "\\s-(e|en|enc|enco|encodedcommand)\\s+[A-Za-z0-9+/=]{20,}"}]},
      {"id": "beh.script.download_cradle", "version": "1", "title": "Script download cradle",
       "technique": "T1105", "severity": "high", "kind": "process_start",
       "any": [{"field": "cmdline", "regex": "(DownloadString|DownloadFile|Invoke-WebRequest|iwr\\s|curl\\s+[^|]*\\|\\s*(ba)?sh|wget\\s+[^|]*\\|\\s*(ba)?sh)"},
               {"field": "cmdline", "regex": "certutil(\\.exe)?\\s+.*-urlcache\\s+.*-f"}]},
      {"id": "beh.lolbin.proxy_execution", "version": "1", "title": "Signed binary proxy execution",
       "technique": "T1218", "severity": "medium", "kind": "process_start",
       "any": [{"field": "cmdline", "regex": "mshta(\\.exe)?\\s+(https?|javascript|vbscript):"},
               {"field": "cmdline", "regex": "regsvr32(\\.exe)?\\s+.*/i:https?://"},
               {"field": "cmdline", "regex": "rundll32(\\.exe)?\\s+javascript:"}]},
      {"id": "beh.cred.lsass_dump", "version": "1", "title": "Credential access: LSASS memory dump",
       "technique": "T1003.001", "severity": "critical", "kind": "process_start",
       "any": [{"field": "cmdline", "regex": "procdump(64)?(\\.exe)?\\s+.*-ma\\s+.*lsass"},
               {"field": "cmdline", "regex": "comsvcs(\\.dll)?[, ]+#?24|comsvcs(\\.dll)?,\\s*MiniDump"},
               {"field": "cmdline", "regex": "sekurlsa::|lsadump::"}]},
      {"id": "beh.cred.shadow_read", "version": "1", "title": "Credential access: password store read",
       "technique": "T1003.008", "severity": "high", "kind": "file_open",
       "all": [{"field": "path", "regex": "^/etc/(shadow|gshadow)$|\\\\config\\\\SAM$|\\\\NTDS\\\\ntds\\.dit$"}],
       "any": [{"field": "process", "regex": "^(?!passwd$|chage$|sshd$|login$|su$|sudo$|unix_chkpwd$|lsass\\.exe$).*"}]},
      {"id": "beh.ransom.shadow_delete", "version": "1", "title": "Ransomware-like: backup/shadow copy deletion",
       "technique": "T1490", "severity": "critical", "kind": "process_start",
       "any": [{"field": "cmdline", "regex": "vssadmin(\\.exe)?\\s+delete\\s+shadows"},
               {"field": "cmdline", "regex": "wmic(\\.exe)?\\s+shadowcopy\\s+delete"},
               {"field": "cmdline", "regex": "wbadmin(\\.exe)?\\s+delete\\s+(catalog|systemstatebackup)"},
               {"field": "cmdline", "regex": "bcdedit(\\.exe)?\\s+/set\\s+.*recoveryenabled\\s+no"}]},
      {"id": "beh.ransom.mass_modify", "version": "1", "title": "Ransomware-like: mass file modification",
       "technique": "T1486", "severity": "critical", "kind": "file_modify",
       "any": [{"field": "path", "regex": ".*"}],
       "threshold": {"count": 50, "window_s": 10, "group_by": "pid"}},
      {"id": "beh.admin.remote_exec", "version": "1", "title": "Administration tool used for remote execution",
       "technique": "T1569.002", "severity": "high", "kind": "process_start",
       "any": [{"field": "cmdline", "regex": "psexec(64)?(\\.exe)?\\s+\\\\\\\\"},
               {"field": "cmdline", "regex": "wmic(\\.exe)?\\s+/node:\\S+\\s+process\\s+call\\s+create"},
               {"field": "cmdline", "regex": "schtasks(\\.exe)?\\s+/create\\s+.*/s\\s+\\S+"},
               {"field": "cmdline", "regex": "winrs(\\.exe)?\\s+-r:"}]},
      {"id": "beh.persist.autostart", "version": "1", "title": "Persistence: autostart location modified",
       "technique": "T1547", "severity": "medium", "kind": "persistence_change",
       "any": [{"field": "location", "regex": "CurrentVersion\\\\Run|/etc/cron|/var/spool/cron|LaunchAgents|LaunchDaemons|/etc/systemd/system|\\.config/autostart"}]},
      {"id": "beh.network.malicious_destination", "version": "1", "title": "Connection to known malicious destination",
       "technique": "T1071", "severity": "high", "kind": "network_connect",
       "any": [{"field": "reputation", "equals": "malicious"}]},
      {"id": "beh.network.remote_admin", "version": "1", "title": "Unusual remote administration connection",
       "technique": "T1021", "severity": "medium", "kind": "network_connect",
       "all": [{"field": "direction", "equals": "inbound"}],
       "any": [{"field": "remote_port", "in": ["3389", "5985", "5986", "22", "5900"]}]},
      {"id": "beh.media.removable_mounted", "version": "1", "title": "Removable media connected",
       "technique": "T1091", "severity": "low", "kind": "removable_media",
       "any": [{"field": "action", "equals": "mounted"}]},
      {"id": "beh.tamper.agent", "version": "1", "title": "Agent tamper attempt",
       "technique": "T1562.001", "severity": "critical", "kind": "tamper",
       "any": [{"field": "action", "regex": ".+"}]},
      {"id": "beh.evasion.log_clear", "version": "1", "title": "Defence evasion: event log cleared",
       "technique": "T1070.001", "severity": "high", "kind": "process_start",
       "any": [{"field": "cmdline", "regex": "wevtutil(\\.exe)?\\s+(cl|clear-log)\\s"},
               {"field": "cmdline", "regex": "Clear-EventLog"},
               {"field": "cmdline", "regex": "(^|\\s)(rm|shred)\\s+.*/var/log/(auth|secure|syslog)"}]}
    ]
  }
}
