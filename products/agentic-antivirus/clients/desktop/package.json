{
  "name": "agentic-antivirus-desktop",
  "version": "0.1.0",
  "description": "Agentic Antivirus console for Windows, macOS and Linux",
  "main": "main.js",
  "author": {
    "name": "Equality Software Ltd",
    "email": "ali.abdalla@softwareequality.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.equalitysoftware.agenticantivirus",
    "productName": "Agentic Antivirus",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "policy.js"
    ],
    "artifactName": "agentic-antivirus-${version}-${env.AAV_CHANNEL}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "System",
      "maintainer": "Equality Software Ltd <ali.abdalla@softwareequality.com>"
    }
  },
  "homepage": "https://softwareequality.com/agentic-antivirus"
}
