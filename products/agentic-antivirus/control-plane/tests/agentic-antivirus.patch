+++ b/products/agentic-antivirus/control-plane/tests/test_self_correct.py
@@ -0,0 +1,55 @@
+"""SC-01..12: bounds of the self-correction loop."""
+import subprocess
+import sys
+
+import pytest
+
+from conftest import PRODUCT
+
+sys.path.insert(0, str(PRODUCT / "tools"))
+import self_correct as sc  # noqa: E402
+
+JUNIT = """<testsuite tests="2" failures="1"><testcase classname="t" name="ok"/>
+<testcase classname="tests.test_x" name="test_restore"><failure message="RSP-04 restore without reason">
+AssertionError password=hunter2 postgresql://aav:topsecret@db/aav Bearer abcdefghijklmnopqrstuvwxyz</failure></testcase></testsuite>"""
+
+
+@pytest.fixture
+def repo(tmp_path):
+    subprocess.run(["git", "init", "-q", "-b", "master"], cwd=tmp_path, check=True)
+    (tmp_path / "f").write_text("x")
+    subprocess.run(["git", "add", "-A"], cwd=tmp_path, check=True)
+    subprocess.run(["git", "-c", "user.email=a@b", "-c", "user.name=t", "commit", "-qm", "init"], cwd=tmp_path, check=True)
+    (tmp_path / "junit.xml").write_text(JUNIT)
+    return tmp_path
+
+
+def test_observe_redacts_secrets_and_extracts_requirements(repo):
+    f = sc.observe(str(repo / "junit.xml"))
+    assert len(f) == 1 and f[0].requirement_ids == ["RSP-04"]
+    assert "hunter2" not in f[0].message and "topsecret" not in f[0].message and "abcdefghijklmnop" not in f[0].message
+
+
+def test_attempt_limit_then_escalation(repo, monkeypatch):
+    monkeypatch.delenv("AAV_AEPX_BUS_URL", raising=False)
+    b = sc.Budget(10_000, 1.0)
+    for i in range(5):
+        assert sc.correct(repo, str(repo / "junit.xml"), b)[0]["outcome"].startswith("diagnosis only")
+    assert sc.correct(repo, str(repo / "junit.xml"), b)[0]["outcome"].startswith("escalated")
+
+
+def test_budget_cap_and_no_recursion(repo, monkeypatch):
+    b = sc.Budget(100, 1.0)
+    with pytest.raises(RuntimeError):
+        b.reserve(101, 0)
+    monkeypatch.setenv("AAV_SELFCORRECT_ACTIVE", "1")
+    with pytest.raises(RuntimeError):
+        sc.correct(repo, str(repo / "junit.xml"), sc.Budget(1000, 1))
+
+
+def test_only_verified_learning_and_no_merge_path(repo):
+    led = sc.Ledger(repo)
+    with pytest.raises(ValueError):
+        led.learn({"verified": False})
+    src = (PRODUCT / "tools" / "self_correct.py").read_text()
+    assert "gh pr merge" not in src and "--draft" in src and "deploy" not in src.split('"""', 2)[2].lower()
diff --git a/products/agentic-antivirus/deploy/backup.sh b/products/agentic-antivirus/deploy/backup.sh
new file mode 100755
index 0000000..3173032
--- /dev/null
+++ b/products/agentic-antivirus/deploy/backup.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# Encrypted logical backup (OCI-10). Stores on the VM's boot/block volume within Always Free storage.
+# Requires AAV_BACKUP_PASSPHRASE_FILE (mode 600). Keeps the last 14 backups.
+set -euo pipefail
+cd "$(dirname "$0")"
+OUT=${AAV_BACKUP_DIR:-/var/backups/aav}; mkdir -p "$OUT"; chmod 700 "$OUT"
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+docker compose exec -T postgres pg_dump -U aav_owner -d aav --format=custom \
+  | openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt -pass "file:${AAV_BACKUP_PASSPHRASE_FILE:?}" > "$OUT/aav-$STAMP.dump.enc"
+sha256sum "$OUT/aav-$STAMP.dump.enc" > "$OUT/aav-$STAMP.dump.enc.sha256"
+ls -1t "$OUT"/aav-*.dump.enc | tail -n +15 | xargs -r -I{} sh -c 'rm -f "{}" "{}.sha256"'
+echo "backup written: $OUT/aav-$STAMP.dump.enc"
diff --git a/products/agentic-antivirus/deploy/compose.yml b/products/agentic-antivirus/deploy/compose.yml
new file mode 100644
index 0000000..10a374e
--- /dev/null
+++ b/products/agentic-antivirus/deploy/compose.yml
@@ -0,0 +1,57 @@
+# Agentic Antivirus on one OCI Always Free VM.Standard.A1.Flex (arm64). Staging/production overlay is
+# manual and approval-gated. Only the console listener is published, on loopback; the host's existing
+# TLS reverse proxy forwards /apps/agentic-antivirus/ to it. Totals: <= 2.6 GB RAM, <= 2.1 OCPU.
+name: agentic-antivirus
+services:
+  postgres:
+    image: postgres:16-alpine
+    restart: unless-stopped
+    mem_limit: 768m
+    cpus: "0.75"
+    environment:
+      POSTGRES_DB: aav
+      POSTGRES_USER: aav_owner
+      POSTGRES_PASSWORD: ${AAV_POSTGRES_PASSWORD:?set AAV_POSTGRES_PASSWORD}
+      AAV_APP_DB_PASSWORD: ${AAV_APP_DB_PASSWORD:?set AAV_APP_DB_PASSWORD}
+    volumes:
+      - aavdata:/var/lib/postgresql/data
+      - ../control-plane/migrations:/migrations:ro
+      - ./init:/docker-entrypoint-initdb.d:ro
+    healthcheck: { test: ["CMD-SHELL", "pg_isready -U aav_owner -d aav"], interval: 10s, retries: 8 }
+  governance:
+    build: ../../../services/governance
+    restart: unless-stopped
+    mem_limit: 256m
+    cpus: "0.25"
+    environment:
+      DATABASE_URL: postgresql://unused@127.0.0.1:1/none   # policy evaluation only; audit lives in aav.audit_log
+  control-plane:
+    build: { context: .., dockerfile: control-plane/Dockerfile }
+    restart: unless-stopped
+    mem_limit: 768m
+    cpus: "0.75"
+    environment:
+      AAV_DATABASE_URL: postgresql://aav_app:${AAV_APP_DB_PASSWORD}@postgres:5432/aav
+      AAV_SIGNING_KEY_FILE: /run/secrets/aav_signing_key
+      AAV_GOVERNANCE_URL: http://governance:8000
+      AAV_PUBLIC_BASE_URL: https://softwareequality.com/apps/agentic-antivirus
+      AAV_EGRESS_ALLOWLIST: ${AAV_EGRESS_ALLOWLIST:-}
+      AAV_OPEN_REGISTRATION: ${AAV_OPEN_REGISTRATION:-true}
+      AAV_PLAY_SERVICE_ACCOUNT_FILE: ${AAV_PLAY_SERVICE_ACCOUNT_FILE:-}
+    secrets: [aav_signing_key]
+    volumes: [aavfiles:/var/lib/aav/files]
+    depends_on: { postgres: { condition: service_healthy }, governance: { condition: service_started } }
+    healthcheck: { test: ["CMD", "python", "-c", "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/ready')"], interval: 30s, retries: 3 }
+  web:
+    build: { context: .., dockerfile: web/Dockerfile }
+    restart: unless-stopped
+    mem_limit: 128m
+    cpus: "0.25"
+    ports: ["127.0.0.1:18480:8080"]
+    depends_on: [control-plane]
+secrets:
+  aav_signing_key:
+    file: "${AAV_SIGNING_KEY_PATH:?set AAV_SIGNING_KEY_PATH}"
+volumes:
+  aavdata: {}
+  aavfiles: {}
diff --git a/products/agentic-antivirus/deploy/deploy.sh b/products/agentic-antivirus/deploy/deploy.sh
new file mode 100755
index 0000000..ebc9611
--- /dev/null
+++ b/products/agentic-antivirus/deploy/deploy.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+# Runs ON the OCI VM, invoked only by the approval-gated deploy-production job (or manually by the release
+# owner). Order: preflight guard -> encrypted backup -> build/start -> readiness + smoke -> on failure roll back
+# to the previous verified SHA (CI-14, CI-15, OCI-13, RA-11, RA-12).
+set -euo pipefail
+SHA=${1:?usage: deploy.sh VERIFIED_SHA}
+cd "$(dirname "$0")"
+test "$(git rev-parse HEAD)" = "$SHA" || { echo "checkout is not $SHA" >&2; exit 1; }
+PREV=$(cat .last-verified-sha 2>/dev/null || true)
+set -a; . /etc/aav/aav.env; set +a        # secrets live on the host (mode 600), never in git
+python3 guard.py >/dev/null
+./backup.sh
+docker compose up -d --build
+for i in $(seq 1 30); do
+  if curl -fsS http://127.0.0.1:18480/api/ready >/dev/null; then break; fi
+  sleep 5
+done
+if curl -fsS http://127.0.0.1:18480/api/ready | grep -q '"ready":true' && curl -fsS http://127.0.0.1:18480/login/ >/dev/null; then
+  echo "$SHA" > .last-verified-sha
+  curl -fsS http://127.0.0.1:18480/api/health
+  echo "deployed $SHA"
+else
+  echo "readiness failed; rolling back to ${PREV:-nothing}" >&2
+  if [ -n "$PREV" ]; then git -C ../../.. checkout "$PREV" && docker compose up -d --build; fi
+  exit 1
+fi
diff --git a/products/agentic-antivirus/deploy/guard.py b/products/agentic-antivirus/deploy/guard.py
new file mode 100755
index 0000000..0cbf03e
--- /dev/null
+++ b/products/agentic-antivirus/deploy/guard.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Static fail-closed checks for deploy/compose.yml (OCI-02/05/09/14, INT-10, DLV-09).
+Uses `docker compose config` (no daemon or containers needed)."""
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+ALWAYS_FREE = {"ocpu": 4.0, "memory_gb": 24.0}   # tenancy-wide A1 allowance; verify current figures in preflight
+env = dict(os.environ, AAV_POSTGRES_PASSWORD="x" * 32, AAV_APP_DB_PASSWORD="y" * 32,
+           AAV_SIGNING_KEY_PATH=str(HERE / "guard.py"))
+cfg = json.loads(subprocess.check_output(["docker", "compose", "-f", str(HERE / "compose.yml"), "config", "--format", "json"],
+                                         env=env, text=True))
+errors, cpu, mem = [], 0.0, 0
+for name, s in cfg["services"].items():
+    for p in s.get("ports", []):
+        if p.get("host_ip") != "127.0.0.1":
+            errors.append(f"{name}: port {p} is not loopback-only")
+    if s.get("privileged") or s.get("network_mode") == "host":
+        errors.append(f"{name}: privileged or host networking")
+    for v in s.get("volumes", []):
+        if v.get("source") == "/var/run/docker.sock":
+            errors.append(f"{name}: docker socket mounted")
+    if "mem_limit" not in s or "cpus" not in s:
+        errors.append(f"{name}: missing mem_limit/cpus")
+    cpu += float(s.get("cpus", 0))
+    mem += int(s.get("mem_limit", 0))
+    envs = json.dumps(s.get("environment", {})).lower()
+    for marker in ("aws_", "azure_", "oci_lb", "loadbalancer"):
+        if marker in envs:
+            errors.append(f"{name}: references a chargeable service ({marker})")
+if "aav_signing_key" not in cfg.get("secrets", {}):
+    errors.append("signing key must be a compose secret, not an environment variable")
+if cpu > ALWAYS_FREE["ocpu"] or mem / 1024 ** 3 > ALWAYS_FREE["memory_gb"]:
+    errors.append(f"resource totals {cpu} OCPU / {mem / 1024 ** 3:.1f} GB exceed the Always Free A1 allowance")
+report = {"services": len(cfg["services"]), "cpus_total": round(cpu, 2), "memory_gb_total": round(mem / 1024 ** 3, 2),
+          "errors": errors}
+print(json.dumps(report, indent=1))
+sys.exit(1 if errors else 0)
