+    with db.global_tx() as cur:
+        cur.execute("UPDATE aav.users SET display_name = COALESCE(%s, display_name), locale = COALESCE(%s, locale) "
+                    "WHERE id = %s", (body.display_name, body.locale, p.user_id))
