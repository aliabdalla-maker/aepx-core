+                    "RETURNING id", (p.tenant_id, incident_id, body.device_id, body.step))
+        rid = cur.fetchone()["id"]
+        audit.record(cur, tenant_id=p.tenant_id, actor=p.actor, action="recovery.add", target=str(rid))
