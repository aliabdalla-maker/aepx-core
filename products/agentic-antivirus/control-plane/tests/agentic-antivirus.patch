diff --git a/products/agentic-antivirus/clients/android/app/src/test/java/com/equalitysoftware/agenticantivirus/AdPolicyTest.kt b/products/agentic-antivirus/clients/android/app/src/test/java/com/equalitysoftware/agenticantivirus/AdPolicyTest.kt
