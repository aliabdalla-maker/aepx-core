+    capacity_assumptions: "", exception_note: "" });
+  const set = (k: keyof typeof a) => (e: any) => setA({ ...a, [k]: e.target.value });
+  return (
+    <Shell>
+      <h1>{t("nav.ddos")}</h1>
+      <p className="lede">Traffic floods are absorbed by your upstream provider. Here you account for every public endpoint, watch provider alerts, and approve new traffic restrictions.</p>
+      <Freshness at={st.at} />
+      <Status error={cov.error} loading={!cov.data} />
+      {cov.data && <div className="stats">
+        <div><strong>{cov.data.accounted_pct ?? "—"}%</strong><span>public endpoints accounted for ({cov.data.accounted_for}/{cov.data.public_endpoints})</span></div>
+        <div><strong>{st.data?.mitigation_active.length ?? 0}</strong><span>assets under active mitigation</span></div>
+        <div><strong>{st.data?.affected_assets.length ?? 0}</strong><span>assets with alerts in 24 hours</span></div>
+      </div>}
+      {cov.data?.uncovered.length > 0 && <p className="banner warn">Not covered: {cov.data.uncovered.map((u: any) => u.value).join(", ")}</p>}
+
+      <h2>Provider alerts (24 hours)</h2>
+      <table><thead><tr><th>Received</th><th>Signal</th><th>Type</th><th>{t("alerts.severity")}</th><th>Asset</th><th>Impact</th><th>Notified after</th></tr></thead>
+        <tbody>{(st.data?.recent_alerts ?? []).map((x: any) => <tr key={x.id}><td>{formatDateTime(x.received_at, locale)}</td><td>{x.signal_kind}
+          {x.simulation === "true" && <span className="chip sim">{t("common.simulation")}</span>}</td><td>{x.category}</td><td><Sev s={x.severity} /></td>
+          <td>{x.asset}</td><td>{x.confirmed ? "confirmed" : "suspected"}</td>
+          <td>{x.notified_at ? `${Math.round((+new Date(x.notified_at) - +new Date(x.received_at)) / 1000)} s` : "—"}</td></tr>)}</tbody></table>
+
+      <h2>Public endpoints</h2>
+      <table><thead><tr><th>Endpoint</th><th>Service</th><th>Owner</th><th>Provider</th><th>Mitigation</th><th>Capacity</th><th>Exception</th></tr></thead>
+        <tbody>{(assets.data ?? []).map((x) => <tr key={x.id}><td>{x.value}{!x.covered && <span className="chip sim">uncovered</span>}</td>
+          <td>{x.service}</td><td>{x.service_owner}</td><td>{x.provider ?? "—"}</td><td>{x.mitigation_policy ?? "—"}</td>
+          <td>{x.capacity_assumptions ?? "—"}</td><td>{x.exception_note ?? ""}</td></tr>)}</tbody></table>
+      <div className="form">
+        <div className="row"><select aria-label="Kind" value={a.kind} onChange={set("kind")}><option value="hostname">Hostname</option><option value="ip">IP address</option><option value="dns_zone">DNS zone</option></select>
+          <input aria-label="Endpoint" placeholder="shop.example.com" value={a.value} onChange={set("value")} /></div>
+        {(["service", "service_owner", "provider", "mitigation_policy", "capacity_assumptions", "exception_note"] as const).map((k) =>
+          <label key={k}>{k.replace(/_/g, " ")}<input value={a[k]} onChange={set(k)} /></label>)}
+        <Act className="primary" label="Save endpoint" run={() => api("/v1/assets", { body: Object.fromEntries(Object.entries(a).map(([k, v]) => [k, v || null])) })} onDone={() => { assets.reload(); cov.reload(); }} />
+      </div>
+
+      <h2>Service objectives</h2>
+      <table><thead><tr><th>Service</th><th>Availability</th><th>p95 latency</th><th>Legitimate request success</th></tr></thead>
+        <tbody>{(slos.data ?? []).map((s) => <tr key={s.id}><td>{s.service}</td><td>{s.availability_pct}%</td><td>{s.latency_p95_ms} ms</td><td>{s.success_rate_pct}%</td></tr>)}</tbody></table>
+
+      <h2>Traffic restrictions</h2>
+      <table><thead><tr><th>Service</th><th>Control</th><th>Settings</th><th>Status</th><th /></tr></thead>
+        <tbody>{(tps.data ?? []).map((p) => <tr key={p.id}><td>{p.service}</td><td>{p.control}</td><td><code>{JSON.stringify(p.config)}</code></td>
+          <td>{p.status}{p.standing ? " (standing)" : ""}</td>
+          <td><Act label="Roll back" run={() => api(`/v1/traffic-policies/${p.id}/rollback`, { method: "POST" })} onDone={tps.reload} /></td></tr>)}</tbody></table>
+    </Shell>);
+}
diff --git a/products/agentic-antivirus/web/app/devices/page.tsx b/products/agentic-antivirus/web/app/devices/page.tsx
new file mode 100644
index 0000000..75658a3
--- /dev/null
+++ b/products/agentic-antivirus/web/app/devices/page.tsx
@@ -0,0 +1,46 @@
+"use client";
+import { useState } from "react";
+import { Shell } from "../../components/Shell";
+import { Act, AdSlot, Freshness, Status, useApi } from "../../components/ui";
+import { api } from "../../lib/api";
+import { useI18n } from "../../lib/i18n";
+import { formatRelative, localeIncludes } from "../../lib/format";
+
+export default function Devices() {
+  const { t, locale } = useI18n();
+  const d = useApi<any[]>("/v1/devices");
+  const pol = useApi<any[]>("/v1/policies");
+  const lic = useApi("/v1/licence");
+  const [token, setToken] = useState<string | null>(null);
+  const [q, setQ] = useState("");
+  const names = Array.from(new Set((pol.data ?? []).map((p) => p.name)));
+  return (
+    <Shell>
+      <h1>{t("nav.devices")}</h1>
+      <Freshness at={d.at} />
+      <div className="row">
+        <label style={{ margin: 0 }}>{t("common.search")}<input value={q} onChange={(e) => setQ(e.target.value)} /></label>
+        <Act label={t("devices.enrol")} run={() => api("/v1/enrollment-tokens", { body: { max_uses: 1, expires_hours: 24 } })}
+          onDone={(r: any) => setToken(r.token)} />
+      </div>
+      {token && <div className="banner" role="status"><p>Run on the device within 24 hours (one use):</p>
+        <code style={{ overflowWrap: "anywhere" }}>aav-agent enrol --url {location.origin}/api --token {token}</code></div>}
+      <Status error={d.error} loading={!d.data} />
+      <table><thead><tr><th>{t("devices.hostname")}</th><th>{t("devices.os")}</th><th>{t("devices.status")}</th><th>Definitions</th>
+        <th>{t("devices.policy")}</th><th>{t("devices.last_seen")}</th><th>{t("devices.issues")}</th><th>Scan</th></tr></thead>
+        <tbody>{(d.data ?? []).filter((x) => localeIncludes(x.hostname, q, locale)).map((x) => <tr key={x.id}>
+          <td>{x.hostname}{x.criticality === "critical" && <span className="chip">critical</span>}
+            {x.isolation_state === "isolated" && <span className="chip sim">isolated until {formatRelative(x.isolation_expires_at, locale)}</span>}</td>
+          <td>{x.os} {x.os_version}</td>
+          <td className={x.protection_status === "protected" ? "ok" : "sev-high"}>{x.protection_status}</td>
+          <td>{x.definitions_version ?? "none"}</td>
+          <td><select aria-label={`Policy for ${x.hostname}`} value={x.policy_name ?? ""} onChange={async (e) => {
+            await api(`/v1/devices/${x.id}`, { method: "PATCH", body: { policy_name: e.target.value } }); d.reload(); }}>
+            {names.map((n) => <option key={n}>{n}</option>)}</select> v{x.applied_policy_version ?? "?"}</td>
+          <td>{formatRelative(x.last_seen_at, locale)}</td>
+          <td>{x.issues.map((i: string) => <span key={i} className="chip">{t(`devices.issue.${i}`)}</span>)}</td>
+          <td><Act label="Quick scan" run={() => api("/v1/scans", { body: { device_ids: [x.id], scan_type: "quick" } })} /></td>
+        </tr>)}</tbody></table>
+      {lic.data && <AdSlot placement="device_list_banner" rate={lic.data.ad_rate} />}
+    </Shell>);
+}
diff --git a/products/agentic-antivirus/web/app/files/page.tsx b/products/agentic-antivirus/web/app/files/page.tsx
new file mode 100644
index 0000000..c35ac15
--- /dev/null
+++ b/products/agentic-antivirus/web/app/files/page.tsx
@@ -0,0 +1,77 @@
+"use client";
+import { useRef, useState } from "react";
+import { Shell } from "../../components/Shell";
+import { Act, Status, useApi } from "../../components/ui";
+import { api, API_BASE, session } from "../../lib/api";
+import { useI18n } from "../../lib/i18n";
+import { formatDateTime, formatNumber } from "../../lib/format";
+
+export default function Files() {
+  const { t, locale } = useI18n();
+  const [trail, setTrail] = useState<{ id: string | null; name: string }[]>([{ id: null, name: "Files" }]);
+  const [trashed, setTrashed] = useState(false);
+  const [q, setQ] = useState("");
+  const [sort, setSort] = useState("name");
+  const cur = trail[trail.length - 1].id;
+  const d = useApi<any[]>("/v1/files", { parent_id: cur ?? undefined, trashed, q: q || undefined, sort });
+  const caps = useApi<any>("/v1/files/handlers");
+  const input = useRef<HTMLInputElement>(null);
+  const archive = useRef<HTMLInputElement>(null);
+  const [preview, setPreview] = useState<{ name: string; text?: string; img?: string } | null>(null);
+
+  const upload = async (files: FileList | null, path = "/v1/files/upload") => {
+    for (const f of Array.from(files ?? [])) {
+      const fd = new FormData(); fd.append("file", f);
+      await api(path, { form: fd, query: { parent_id: cur ?? undefined } });
+    }
+    d.reload();
+  };
+  const download = async (id: string, name: string, suffix = "download") => {
+    const r = await fetch(`${API_BASE}/v1/files/${id}/${suffix}`, { headers: { Authorization: `Bearer ${session.token()}`,
+      "X-Tenant-Id": session.tenant() ?? "" } });
+    const url = URL.createObjectURL(await r.blob());
+    const a = document.createElement("a"); a.href = url; a.download = name; a.click(); URL.revokeObjectURL(url);
+  };
+  const can = (mime: string, what: "preview" | "edit") => (caps.data?.handlers[mime] ?? caps.data?.default)?.[what];
+  return (
+    <Shell>
+      <h1>{t("nav.files")}</h1>
+      <nav aria-label="Folder path" className="row">{trail.map((c, i) =>
+        <button key={i} onClick={() => setTrail(trail.slice(0, i + 1))} aria-current={i === trail.length - 1 ? "page" : undefined}>{c.name}</button>)}</nav>
+      <div className="row" style={{ margin: "1rem 0" }}>
+        <button onClick={() => input.current?.click()}>{t("files.upload")}</button>
+        <input ref={input} type="file" multiple hidden onChange={(e) => upload(e.target.files)} />
+        <button onClick={() => archive.current?.click()}>Import zip or tar</button>
+        <input ref={archive} type="file" accept=".zip,.tar,.gz,.tgz" hidden onChange={(e) => upload(e.target.files, "/v1/files/import")} />
+        <Act label={t("files.new_folder")} run={async () => { const name = window.prompt("Folder name"); if (name) await api("/v1/files/folders", { body: { name, parent_id: cur } }); }} onDone={d.reload} />
+        <label style={{ margin: 0 }}>{t("common.search")}<input value={q} onChange={(e) => setQ(e.target.value)} /></label>
+        <label style={{ margin: 0 }}>Sort<select value={sort} onChange={(e) => setSort(e.target.value)}>
+          <option value="name">Name</option><option value="updated_at">Last changed</option><option value="size_bytes">Size</option></select></label>
+        <label style={{ margin: 0, display: "flex", gap: ".4rem" }}><input type="checkbox" checked={trashed} onChange={(e) => setTrashed(e.target.checked)} />Trash</label>
+      </div>
+      <Status error={d.error} loading={!d.data} />
+      <table><thead><tr><th>Name</th><th>Type</th><th>Size</th><th>Changed</th><th>Actions</th></tr></thead>
+        <tbody>{(d.data ?? []).map((n) => <tr key={n.id}>
+          <td>{n.kind === "dir" && !trashed ? <button onClick={() => setTrail([...trail, { id: n.id, name: n.name }])}>{n.name}/</button> : n.name}</td>
+          <td>{n.kind === "dir" ? "Folder" : n.mime}</td><td>{n.size_bytes != null ? `${formatNumber(n.size_bytes, locale)} B` : ""}</td>
+          <td>{formatDateTime(n.updated_at, locale)}</td>
+          <td className="row">{trashed ? <Act label={t("files.restore")} run={() => api(`/v1/files/${n.id}/restore`, { method: "POST" })} onDone={d.reload} /> : <>
+            {n.kind === "file" && <button onClick={() => download(n.id, n.name)}>{t("files.download")}</button>}
+            {n.kind === "dir" && <button onClick={() => download(n.id, `${n.name}.zip`, "export?fmt=zip")}>{t("common.export")}</button>}
+            {n.kind === "file" && can(n.mime, "preview") && <button onClick={async () => {
+              if (n.mime.startsWith("image/")) {
+                const r = await fetch(`${API_BASE}/v1/files/${n.id}/preview`, { headers: { Authorization: `Bearer ${session.token()}`, "X-Tenant-Id": session.tenant() ?? "" } });
+                setPreview({ name: n.name, img: URL.createObjectURL(await r.blob()) });
+              } else setPreview({ name: n.name, text: (await api(`/v1/files/${n.id}/preview`)).text });
+            }}>Preview</button>}
+            <Act label={t("files.rename")} run={async () => { const name = window.prompt("New name", n.name); if (name) await api(`/v1/files/${n.id}`, { method: "PATCH", body: { name } }); }} onDone={d.reload} />
+            <Act label={t("files.copy")} run={() => api(`/v1/files/${n.id}/copy`, { body: { target_parent_id: cur } })} onDone={d.reload} />
+            <Act label={t("files.trash")} run={() => api(`/v1/files/${n.id}`, { method: "DELETE" })} onDone={d.reload} />
+          </>}</td></tr>)}</tbody></table>
+      {preview && <section aria-label={`Preview of ${preview.name}`} className="banner">
+        <div className="row"><strong>{preview.name}</strong><button onClick={() => setPreview(null)}>Close</button></div>
+        {preview.img ? <img src={preview.img} alt={preview.name} style={{ maxWidth: "100%" }} /> : <pre style={{ whiteSpace: "pre-wrap" }}>{preview.text}</pre>}
+      </section>}
+      <p className="lede">Every upload is checked for malware and its real type. Files without a verified viewer are stored and downloadable but not previewed.</p>
+    </Shell>);
+}
diff --git a/products/agentic-antivirus/web/app/forgot/page.tsx b/products/agentic-antivirus/web/app/forgot/page.tsx
