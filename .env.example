# Copy this file to .env and fill in real values there.
# .env is gitignored (see .gitignore) — it never gets committed.
# Docker Compose reads .env automatically from the repo root.

# Stripe secret key for services/billing (Stripe-hosted Checkout Sessions).
# Get it from https://dashboard.stripe.com/apikeys — use sk_test_... while
# testing, sk_live_... only when you're ready to take real payments.
# Leave blank to run billing in its default degrade-clean (no-charge) mode.
STRIPE_API_KEY=

# Optional: live-chain mode (RFC-0006/0008) — see docker-compose.chain.yml
# and docs/Console-and-Bridge.md. Leave all blank for the default no-chain path.
LEDGER_RPC_URL=
LEDGER_CONTRACT_ADDRESS=
LEDGER_PRIVATE_KEY=
POLICY_CONTRACT_ADDRESS=
