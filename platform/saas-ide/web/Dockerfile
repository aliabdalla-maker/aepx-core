FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
ARG NEXT_PUBLIC_IDE_API_URL=""
ARG NEXT_PUBLIC_OIDC_AUTHORITY=""
ARG NEXT_PUBLIC_OIDC_CLIENT_ID=""
ARG NEXT_PUBLIC_IDE_TENANT=""
ARG NEXT_PUBLIC_ADS_ENABLED="false"
ARG NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""
ARG NEXT_PUBLIC_ADSENSE_SLOT_PROJECT_HOME=""
ENV NEXT_PUBLIC_IDE_API_URL=$NEXT_PUBLIC_IDE_API_URL \
    NEXT_PUBLIC_OIDC_AUTHORITY=$NEXT_PUBLIC_OIDC_AUTHORITY \
    NEXT_PUBLIC_OIDC_CLIENT_ID=$NEXT_PUBLIC_OIDC_CLIENT_ID \
    NEXT_PUBLIC_IDE_TENANT=$NEXT_PUBLIC_IDE_TENANT \
    NEXT_PUBLIC_ADS_ENABLED=$NEXT_PUBLIC_ADS_ENABLED \
    NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=$NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR \
    NEXT_PUBLIC_ADSENSE_SLOT_PROJECT_HOME=$NEXT_PUBLIC_ADSENSE_SLOT_PROJECT_HOME
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S aepx && adduser -S aepx -G aepx
COPY --from=build --chown=aepx:aepx /app ./
USER aepx
EXPOSE 3000
CMD ["npm","run","start","--","-H","0.0.0.0"]
