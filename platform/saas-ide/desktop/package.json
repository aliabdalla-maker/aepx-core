{
  "name": "aepx-agentic-ide-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "AEP-X Agentic IDE desktop client",
  "author": {
    "name": "Equality Software Ltd",
    "email": "support@softwareequality.com"
  },
  "homepage": "https://www.softwareequality.com/aepx",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test policy.test.cjs",
    "dist": "electron-builder --publish never"
  },
  "aepx": {
    "ideUrl": "https://ide.softwareequality.com",
    "idpOrigins": []
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "@electron/fuses": "1.8.0"
  },
  "build": {
    "appId": "com.softwareequality.aepx",
    "productName": "AEP-X Agentic IDE",
    "copyright": "Copyright \u00a9 Equality Software Ltd",
    "artifactName": "AEP-X-IDE-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "policy.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "notarize": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Equality Software Ltd <support@softwareequality.com>",
      "synopsis": "Governed agentic development workspace"
    },
    "publish": null,
    "afterPack": "./fuses.cjs"
  }
}
